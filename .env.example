# ============================================================
#  Dank Farm v3 — environment file
#  Fill in the two REQUIRED values, then run:  python -m dankfarm
# ============================================================

# --- REQUIRED ------------------------------------------------
# Your Discord BOT token (Developer Portal > your app > Bot > Reset Token).
# The bot must have "Message Content Intent" enabled.
BOT_TOKEN=

# Your Discord USER id (Developer Mode > right-click your profile > Copy ID).
OWNER_ID=

# --- ADMIN BOT -----------------------------------------------
# Prefix for the text commands.
COMMAND_PREFIX=$

# --- FARMING CADENCE (milliseconds) --------------------------
COMMAND_INTERVAL=4000
CYCLE_INTERVAL=65000
COMMAND_JITTER=1500
CYCLE_JITTER=20000
# Comma-separated list of commands each account sends per cycle.
FARM_COMMANDS=pls beg,pls hunt,pls dig,pls search,pls fish,pls work,pls bal

# --- RELIABILITY ---------------------------------------------
LOGIN_RETRIES=3
MAX_BACKOFF_MS=300000
WATCHDOG_INTERVAL_MS=60000
STALL_MS=180000

# --- STORAGE -------------------------------------------------
# Where JSON state lives. Ephemeral on free hosts; resets on restart.
DATA_DIR=data

# --- KEEP-ALIVE WEB SERVER -----------------------------------
# Set false on hosts that keep the process alive themselves and reserve the
# port (e.g. bot-hosting.net). A failed bind is non-fatal either way.
KEEP_ALIVE=true
PORT=10000
# Public URL the self-ping hits. On Render leave blank: RENDER_EXTERNAL_URL is used.
SELF_URL=
SELF_PING_MS=240000

# --- BRANDING ------------------------------------------------
BRAND_NAME=DANK FARM
BRAND_TAGLINE=Multi-Account Automation Suite

# --- DIAGNOSTICS ---------------------------------------------
DEBUG_STATS=false
