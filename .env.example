# Discord bot configuration (used when running locally with Node 20.6+).
# On Render these are set as Environment Variables in the dashboard instead.

BOT_TOKEN=your_discord_bot_token_here
OWNER_ID=your_discord_user_id_here

# Optional tuning
# COMMAND_PREFIX=$
# DATA_DIR=storage
# COMMAND_INTERVAL=3000
# CYCLE_INTERVAL=45000
# FARM_COMMANDS=pls beg,pls hunt,pls dig,pls bal
# DEBUG_STATS=false
# COMMAND_JITTER=1500
# CYCLE_JITTER=15000
# WATCHDOG_INTERVAL=60000
# STALL_MS=90000
# LOGIN_RETRIES=3
# MAX_BACKOFF=300000
# CLIENT_BUILD_NUMBER=455964
# CLIENT_VERSION=1.0.9210
# KEEP_ALIVE=true
# PORT=3000
# SELF_URL=https://your-service.onrender.com
# SELF_PING_MS=600000
