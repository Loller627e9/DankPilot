# ============================================================
#  Dank Farm v3 — environment file
#  Fill in the two REQUIRED values, then run:  python -m dankfarm
# ============================================================

# --- REQUIRED ------------------------------------------------
# Your Discord BOT token (Developer Portal > your app > Bot > Reset Token).
# The bot must have "Message Content Intent" enabled.
BOT_TOKEN=

# Your Discord USER id (Developer Mode > right-click your profile > Copy ID).
OWNER_ID=

# --- ADMIN BOT -----------------------------------------------
# Prefix for the text commands.
COMMAND_PREFIX=$

# --- FARMING CADENCE (milliseconds) --------------------------
COMMAND_INTERVAL=3000
CYCLE_INTERVAL=45000
COMMAND_JITTER=1500
CYCLE_JITTER=20000
# Comma-separated list of commands each account sends per cycle.
FARM_COMMANDS=pls beg,pls hunt,pls dig,pls bal

# Resume farming automatically on boot. On by default so a restart does not
# silently leave the bot idle. Set false to require a manual Start.
AUTO_START=true

# Accounts to re-register on every boot, as token:channelId pairs separated by
# commas or newlines. Strongly recommended on free hosts: the data directory is
# wiped on restart, so without this your accounts disappear and nothing farms.
# Example:
# FARM_ACCOUNTS=MTIz...abc:123456789012345678,NDQ0...xyz:987654321098765432
FARM_ACCOUNTS=

# Seconds a stats panel stays clickable before its buttons expire.
VIEW_TIMEOUT=600

# --- RELIABILITY ---------------------------------------------
LOGIN_RETRIES=3
MAX_BACKOFF_MS=300000
WATCHDOG_INTERVAL_MS=60000
STALL_MS=180000

# --- STORAGE -------------------------------------------------
# Where JSON state lives. Ephemeral on free hosts; resets on restart.
DATA_DIR=data

# --- KEEP-ALIVE WEB SERVER -----------------------------------
# Set false on hosts that keep the process alive themselves and reserve the
# port (e.g. bot-hosting.net). A failed bind is non-fatal either way.
KEEP_ALIVE=true
PORT=10000
# Public URL the self-ping hits. On Render leave blank: RENDER_EXTERNAL_URL is used.
SELF_URL=
SELF_PING_MS=240000

# --- BRANDING ------------------------------------------------
BRAND_NAME=DANK FARM
BRAND_TAGLINE=Multi-Account Automation Suite

# --- DIAGNOSTICS ---------------------------------------------
DEBUG_STATS=false
