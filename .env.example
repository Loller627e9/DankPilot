# ============================================================
#  Dank Farm — environment file
#  Only the first two are required. Everything else has a default.
# ============================================================

# --- REQUIRED ------------------------------------------------
# Your Discord BOT token (Developer Portal > your app > Bot > Reset Token).
# The bot needs the "Message Content Intent" enabled.
BOT_TOKEN=

# Your Discord USER id (Developer Mode > right-click your profile > Copy ID).
OWNER_ID=

# --- FARMING CADENCE (milliseconds) --------------------------
COMMAND_INTERVAL=3000
CYCLE_INTERVAL=45000
# Comma-separated commands each account sends per cycle.
FARM_COMMANDS=pls beg,pls hunt,pls dig,pls bal

# --- SURVIVING A RESTART -------------------------------------
# Accounts to re-register on every boot, as "token:channelId" pairs separated
# by commas or newlines. Strongly recommended on free hosts: the data directory
# is wiped on restart, so without this the accounts disappear and nothing farms.
# FARM_ACCOUNTS=TOKEN_ONE:111111111111111111,TOKEN_TWO:222222222222222222

# Where JSON state lives. Ephemeral on free hosts; resets on restart.
DATA_DIR=storage

# --- KEEP-ALIVE WEB SERVER -----------------------------------
# Free hosts (Render and friends) require a process that answers on PORT.
PORT=10000
# Public URL the self-ping hits. On Render, RENDER_EXTERNAL_URL is used instead.
SELF_URL=
SELF_PING_MS=240000

# --- DIAGNOSTICS ---------------------------------------------
# Extra Discord ids to treat as Dank Memer, comma-separated. Only needed if a
# reply arrives from a second id or a webhook that is not already accepted.
# EXTRA_BOT_IDS=

# --- BRANDING ------------------------------------------------
BRAND_NAME=DANK FARM
COMMAND_PREFIX=$
